// resource.rc.in — CMake generates resource.rc from this template.
// Masquerade metadata is injected from resource_values.local.rc (gitignored).
// Fallbacks below are deliberately neutral: nothing vendor-specific is committed.

@RESOURCE_LOCAL_INCLUDE@

#ifndef VER_COMPANYNAME
#define VER_COMPANYNAME      ""
#endif
#ifndef VER_FILEDESCRIPTION
#define VER_FILEDESCRIPTION  "J2534 Trace Proxy"
#endif
#ifndef VER_INTERNALNAME
#define VER_INTERNALNAME     "trace.dll"
#endif
#ifndef VER_LEGALCOPYRIGHT
#define VER_LEGALCOPYRIGHT   ""
#endif
#ifndef VER_ORIGINALFILENAME
#define VER_ORIGINALFILENAME "trace.dll"
#endif
#ifndef VER_PRODUCTNAME
#define VER_PRODUCTNAME      "J2534 Trace Proxy"
#endif
#ifndef VER_COMMENTS
#define VER_COMMENTS         "J2534 trace proxy"
#endif
#ifndef VER_FILEVERSION
#define VER_FILEVERSION      1,0,0,0
#endif
#ifndef VER_PRODUCTVERSION
#define VER_PRODUCTVERSION   1,0,0,0
#endif
#ifndef VER_FILEVERSION_STR
#define VER_FILEVERSION_STR  "1.0.0.0"
#endif
#ifndef VER_PRODUCTVERSION_STR
#define VER_PRODUCTVERSION_STR "1.0.0.0"
#endif
#ifndef VER_ASSEMBLYVERSION
#define VER_ASSEMBLYVERSION  ""
#endif

1 VERSIONINFO
FILEVERSION    VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
FILEOS         0x4
FILETYPE       0x2
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "Assembly Version",   VER_ASSEMBLYVERSION
            VALUE "Comments",            VER_COMMENTS
            VALUE "CompanyName",         VER_COMPANYNAME
            VALUE "FileDescription",      VER_FILEDESCRIPTION
            VALUE "FileVersion",          VER_FILEVERSION_STR
            VALUE "InternalName",         VER_INTERNALNAME
            VALUE "LegalCopyright",       VER_LEGALCOPYRIGHT
            VALUE "LegalTrademarks",      ""
            VALUE "OriginalFilename",     VER_ORIGINALFILENAME
            VALUE "ProductName",           VER_PRODUCTNAME
            VALUE "ProductVersion",       VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04B0
    END
END